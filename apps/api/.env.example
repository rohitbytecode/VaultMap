# VaultMap API Environment Variables
PORT=6770

# Allowed CORS origins (optional: comma-separated for multiple, '*' for all, defaults to request origin if unset)
# CORS_ORIGIN=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Session security
SESSION_SECRET=change-this-dev-session-secret

# GitHub App configuration for private repository access
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_CLIENT_ID=Iv1.abc123
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_CALLBACK_URL=http://localhost:6770/api/github/auth/callback
GITHUB_APP_SETUP_URL=https://github.com/apps/your-vaultmap-app
GITHUB_APP_NAME=vaultmap

# Optional public-only API fallback
# GITHUB_TOKEN=your_github_token_here
