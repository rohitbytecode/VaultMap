# VaultMap API Environment Variables
PORT=6770

# Allowed CORS origins (optional: comma-separated for multiple, '*' for all, defaults to request origin if unset)
# CORS_ORIGIN=http://localhost:5173,https://your-frontend-deployment.vercel.app

# GitHub Personal Access Token (optional: increases GitHub API rate limit from 60 to 5000 requests/hour)
# GITHUB_TOKEN=your_github_token_here
